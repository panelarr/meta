# Tools and build output
/bin/
/dist/
coverage.out
*.test

# The admin UI: dependencies and the build (embedded by Go; only the
# placeholder is committed so the embed always has a directory).
/admin/node_modules/
/admin/dist/*
!/admin/dist/.keep

# Local config and data. Never commit metadata dumps or extracts.
.env
*.local.yaml
/data/
*.sqlite
*.sqlite.zst
*.zst
*.sha1

# Go workspace files are local only
go.work
go.work.sum

.DS_Store
.idea/
.vscode/
